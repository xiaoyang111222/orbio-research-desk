# Your Orbio key. Claim it on orbio.so or through the Orbio MCP (orbio_claim_key).
# It is an OpenRouter key: one key, every model.
OPENROUTER_API_KEY=

# Optional. Any model on openrouter.ai/models; `openrouter/auto` lets the router pick.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1

# Optional. Shown on OpenRouter's public rankings for your app.
APP_NAME=Orbio Research Desk
APP_URL=https://orbio.so/build

# Optional: Orbio gateway instead of OpenRouter direct
# OPENROUTER_BASE_URL=https://api.orbio.so/api/v1

# Optional Telegram delivery (stdout fallback if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Orbio MCP self-funding (dry-run by default)
ORBIO_MCP_URL=https://www.orbio.so/api/mcp
ORBIO_MCP_DRY_RUN=1
ORBIO_MCP_TOKEN=

# Optional default brief topic
BRIEF_TOPIC=tokenised equities crypto markets Robinhood Chain
